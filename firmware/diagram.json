{
  "version": 1,
  "author": "Nhom 3 - De tai 31",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-devkit-c-v4",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "board-ssd1306",
      "id": "oled1",
      "top": -120,
      "left": 200,
      "attrs": { "i2cAddress": "0x3c" }
    },
    {
      "type": "led",
      "id": "led_motor",
      "top": 180,
      "left": 200,
      "attrs": { "color": "red" },
      "comment": "Simulates vibration motor (LED = ON means vibrating)"
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn_emergency",
      "top": -120,
      "left": -100,
      "attrs": { "color": "red", "label": "EMERGENCY" }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn_exercise",
      "top": -50,
      "left": -100,
      "attrs": { "color": "yellow", "label": "EXERCISE" }
    },
    {
      "type": "wokwi-slide-potentiometer",
      "id": "pot_hr",
      "top": 20,
      "left": -120,
      "attrs": { "label": "HR Override" }
    }
  ],
  "connections": [
    ["esp:21", "oled1:SDA", "blue",  ["h20"]],
    ["esp:22", "oled1:SCL", "green", ["h20"]],
    ["oled1:VCC", "esp:3V3", "red",   ["v0"]],
    ["oled1:GND", "esp:GND.2", "black", ["v0"]],

    ["esp:23", "led_motor:A", "red",   ["v0"]],
    ["led_motor:C", "esp:GND.1", "black", ["v0"]],

    ["btn_emergency:1.l", "esp:25", "orange", ["h0"]],
    ["btn_emergency:2.l", "esp:GND.3", "black", ["h0"]],

    ["btn_exercise:1.l", "esp:26", "yellow", ["h0"]],
    ["btn_exercise:2.l", "esp:GND.3", "black", ["h0"]],

    ["pot_hr:SIG", "esp:34", "purple", ["h0"]],
    ["pot_hr:VCC", "esp:3V3", "red", ["h0"]],
    ["pot_hr:GND", "esp:GND.3", "black", ["h0"]]
  ]
}
